rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == "malexlkw@gmail.com" &&
        request.auth.token.email_verified == true;
    }

    // Leitura pública dos arquivos PDF dos livros; escrita exclusiva para o administrador
    match /books/{bookId}/book.pdf {
      allow read: if true;
      allow write: if isAdmin() &&
        (request.resource == null || request.resource.contentType == 'application/pdf');
    }

    // Áudios privados de conversas: restrito exclusivamente aos 2 participantes autenticados
    match /conversations/{conversationId}/audios/{audioFile} {
      allow read: if request.auth != null &&
        conversationId.split('__').size() == 2 &&
        request.auth.uid in conversationId.split('__');
      allow write: if request.auth != null &&
        conversationId.split('__').size() == 2 &&
        request.auth.uid in conversationId.split('__') &&
        request.resource.size <= 10 * 1024 * 1024 &&
        (request.resource.contentType.matches('audio/.*') || request.resource.contentType.matches('video/webm.*'));
      allow delete: if request.auth != null &&
        conversationId.split('__').size() == 2 &&
        request.auth.uid in conversationId.split('__');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
