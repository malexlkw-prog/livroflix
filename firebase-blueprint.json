{
  "entities": {
    "Book": {
      "title": "Book",
      "description": "Catalog book item in LIVROFLIX",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titulo": { "type": "string" },
        "autor": { "type": "string" },
        "capa": { "type": "string" },
        "corTema": { "type": "string" },
        "descricao": { "type": "string" },
        "generos": { "type": "array", "items": { "type": "string" } },
        "personagens": { "type": "array", "items": { "type": "string" } },
        "palavrasChave": { "type": "array", "items": { "type": "string" } },
        "ano": { "type": "number" },
        "paginas": { "type": "number" },
        "idioma": { "type": "string" },
        "editora": { "type": "string" },
        "avaliacao": { "type": "number" },
        "totalAvaliacoes": { "type": "number" },
        "recomendacoesPositivas": { "type": "number" },
        "leiturasCount": { "type": "number" },
        "arquivo": { "type": "string" },
        "pdfUrl": { "type": "string" },
        "pdfPath": { "type": "string" },
        "pdfFileName": { "type": "string" },
        "pdfSize": { "type": "number" },
        "pdfUpdatedAt": { "type": "string" },
        "capitulos": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "numero": { "type": "number" },
              "titulo": { "type": "string" },
              "paginaInicial": { "type": "number" },
              "conteudo": { "type": "string" }
            }
          }
        },
        "status": { "type": "string", "enum": ["ativo", "oculto", "rascunho"] },
        "destaque": { "type": "boolean" },
        "ordem": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "titulo", "autor", "capa", "descricao", "generos", "ano", "paginas", "idioma", "editora", "avaliacao", "status", "destaque"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and aggregate reading statistics",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "nome": { "type": "string", "maxLength": 80 },
        "displayName": { "type": "string", "maxLength": 80 },
        "username": { "type": "string", "maxLength": 30, "pattern": "^[a-z0-9._]{3,30}$" },
        "usernameChangeHistory": {
          "type": "array",
          "description": "ISO timestamps of recent username changes (limited to 2 changes every 15 days)"
        },
        "bio": { "type": "string", "maxLength": 300 },
        "email": { "type": "string" },
        "foto": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "streakDays": { "type": "number" },
        "totalMinutesRead": { "type": "number" },
        "preferenciasLeitor": {
          "type": "object",
          "properties": {
            "fontSize": { "type": "number" },
            "fontFamily": { "type": "string" },
            "lineHeight": { "type": "number" },
            "maxWidth": { "type": "string" },
            "theme": { "type": "string", "enum": ["dark", "sepia", "light"] }
          }
        },
        "profileCustomization": {
          "type": "object",
          "description": "Aesthetic profile customization (background, banner, decorative effects, and theme)"
        },
        "favoriteBooks": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Up to 3 catalog book IDs highlighted on the user profile"
        },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "nome", "role"]
    },
    "UsernameReservation": {
      "title": "UsernameReservation",
      "description": "Unique username reservation mapping @username to user uid",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "username": { "type": "string", "maxLength": 30, "pattern": "^[a-z0-9._]{3,30}$" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "username"]
    },
    "UserBookItem": {
      "title": "UserBookItem",
      "description": "Isolated per-user reading progress, list status, favorite, and rating for a book",
      "type": "object",
      "properties": {
        "bookId": { "type": "string" },
        "userId": { "type": "string" },
        "inMyList": { "type": "boolean" },
        "isFavorite": { "type": "boolean" },
        "isDownloaded": { "type": "boolean" },
        "status": { "type": "string", "enum": ["nenhum", "quero_ler", "lendo", "concluido"] },
        "paginaAtual": { "type": "number" },
        "totalPaginas": { "type": "number" },
        "progresso": { "type": "number" },
        "avaliacaoUsuario": { "type": "number" },
        "recomendaria": { "type": "boolean" },
        "minutosLidos": { "type": "number" },
        "ultimoAcesso": { "type": "string" }
      },
      "required": ["bookId", "userId", "status", "paginaAtual", "progresso"]
    },
    "CustomCategory": {
      "title": "CustomCategory",
      "description": "Admin-managed custom shelf categories",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titulo": { "type": "string" },
        "icone": { "type": "string" },
        "generoFiltro": { "type": "string" },
        "ordem": { "type": "number" }
      },
      "required": ["id", "titulo", "generoFiltro", "ordem"]
    },
    "HomeRow": {
      "title": "HomeRow",
      "description": "Dynamic home screen row shelf configuration managed by administrators",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "titulo": { "type": "string" },
        "ordem": { "type": "number" },
        "ativo": { "type": "boolean" },
        "tipo": {
          "type": "string",
          "enum": ["top10", "em_alta", "para_voce", "bem_avaliados", "genero", "recentes", "manual"]
        },
        "generoFiltro": { "type": "string" },
        "bookIds": { "type": "array", "items": { "type": "string" } },
        "showRank": { "type": "boolean" }
      },
      "required": ["id", "titulo", "ordem", "ativo", "tipo"]
    },
    "PlatformSettings": {
      "title": "PlatformSettings",
      "description": "Global LIVROFLIX visual identity, texts, colors, Hero, Top 10, and navigation settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "siteName": { "type": "string" },
        "logoText": { "type": "string" },
        "footerDescription": { "type": "string" },
        "heroButtonText": { "type": "string" },
        "readButtonText": { "type": "string" },
        "primaryColor": { "type": "string" },
        "accentColor": { "type": "string" },
        "backgroundColor": { "type": "string" },
        "cardBackgroundColor": { "type": "string" },
        "heroBookIds": { "type": "array", "items": { "type": "string" } },
        "heroAutoRotateSeconds": { "type": "number" },
        "top10Mode": { "type": "string", "enum": ["auto", "manual"] },
        "top10BookIds": { "type": "array", "items": { "type": "string" } },
        "headerCategories": { "type": "array", "items": { "type": "string" } },
        "catalogSeeded": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "siteName", "primaryColor", "backgroundColor", "top10Mode", "catalogSeeded"]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Public literary profile card for community interactions (excludes private email and role)",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string", "maxLength": 80 },
        "username": { "type": "string", "maxLength": 30 },
        "bio": { "type": "string", "maxLength": 300 },
        "photoURL": { "type": "string" },
        "profileCustomization": {
          "type": "object",
          "description": "Public aesthetic profile customization (background, banner, decorative effects, and theme)"
        },
        "favoriteBooks": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Up to 3 catalog book IDs highlighted on the public profile"
        },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "displayName", "username", "updatedAt"]
    },
    "CommunityPost": {
      "title": "CommunityPost",
      "description": "Short literary community post (up to 300 characters) with optional image and linked catalog bookId",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string", "maxLength": 80 },
        "authorUsername": { "type": "string", "maxLength": 30 },
        "authorPhoto": { "type": "string" },
        "text": { "type": "string", "maxLength": 300 },
        "imageUrl": { "type": "string" },
        "bookId": { "type": "string" },
        "mentions": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "authorId", "authorName", "authorUsername", "text", "createdAt"]
    },
    "CommunityLike": {
      "title": "CommunityLike",
      "description": "Individual like on a community post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "postId": { "type": "string" },
        "userId": { "type": "string" },
        "postAuthorId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "postId", "userId", "postAuthorId", "createdAt"]
    },
    "CommunityReply": {
      "title": "CommunityReply",
      "description": "Reply to a community post or nested conversation reply (up to 300 characters)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "postId": { "type": "string" },
        "postAuthorId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string", "maxLength": 80 },
        "authorUsername": { "type": "string", "maxLength": 30 },
        "authorPhoto": { "type": "string" },
        "text": { "type": "string", "maxLength": 300 },
        "parentReplyId": { "type": "string" },
        "replyToUsername": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "postId", "postAuthorId", "authorId", "authorName", "authorUsername", "text", "createdAt"]
    },
    "CommunityFollow": {
      "title": "CommunityFollow",
      "description": "Follow relationship between two readers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "followerId": { "type": "string" },
        "followingId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "followerId", "followingId", "createdAt"]
    },
    "CommunityNotification": {
      "title": "CommunityNotification",
      "description": "Notification for follow, like, reply, or @username mention events",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipientId": { "type": "string" },
        "actorId": { "type": "string" },
        "actorName": { "type": "string", "maxLength": 80 },
        "actorUsername": { "type": "string", "maxLength": 30 },
        "actorPhoto": { "type": "string" },
        "type": { "type": "string", "enum": ["follow", "like", "reply", "mention"] },
        "postId": { "type": "string" },
        "replyId": { "type": "string" },
        "snippet": { "type": "string", "maxLength": 300 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "recipientId", "actorId", "actorName", "actorUsername", "type", "read", "createdAt"]
    },
    "CommunityReport": {
      "title": "CommunityReport",
      "description": "Moderation report for posts, reviews, or users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reporterId": { "type": "string" },
        "reporterName": { "type": "string", "maxLength": 80 },
        "targetType": { "type": "string", "enum": ["post", "user", "review"] },
        "targetPostId": { "type": "string" },
        "targetReviewId": { "type": "string" },
        "targetBookId": { "type": "string" },
        "targetUserId": { "type": "string" },
        "targetUsername": { "type": "string", "maxLength": 30 },
        "reason": { "type": "string", "maxLength": 200 },
        "details": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "reviewed", "dismissed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "reporterId", "reporterName", "targetType", "targetUserId", "reason", "status", "createdAt"]
    },
    "BookReview": {
      "title": "BookReview",
      "description": "Literary review (resenha) written by a user for a specific catalog book (1 to 500 characters)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bookId": { "type": "string" },
        "userId": { "type": "string" },
        "authorName": { "type": "string", "maxLength": 80 },
        "authorUsername": { "type": "string", "maxLength": 30 },
        "authorPhoto": { "type": "string" },
        "text": { "type": "string", "minLength": 1, "maxLength": 500 },
        "rating": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "bookId", "userId", "authorName", "authorUsername", "text", "createdAt"]
    },
    "DirectConversation": {
      "title": "DirectConversation",
      "description": "Private 1-on-1 direct message conversation between two community users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participants": { "type": "array", "description": "Two participant UIDs" },
        "lastMessage": { "type": "string", "maxLength": 1000 },
        "lastMessageAt": { "type": "string" },
        "lastSenderId": { "type": "string" },
        "unreadBy": { "type": "array" },
        "unreadCounts": { "type": "object" },
        "participantProfiles": { "type": "object" },
        "typingAt": { "type": "object" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "participants", "lastMessage", "lastMessageAt", "createdAt", "updatedAt"]
    },
    "DirectMessage": {
      "title": "DirectMessage",
      "description": "Individual text message inside a private conversation subcollection",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "senderId": { "type": "string" },
        "recipientId": { "type": "string" },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "createdAt": { "type": "string" },
        "read": { "type": "boolean" },
        "deleted": { "type": "boolean" },
        "hiddenFor": { "type": "array" }
      },
      "required": ["id", "conversationId", "senderId", "recipientId", "text", "createdAt", "read"]
    },
    "ProfileHighlight": {
      "title": "ProfileHighlight",
      "description": "Single active Instagram-style highlight on a user profile (maximum 1 highlight per user, up to 3 photos, 1st photo is coverUrl)",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 30 },
        "photos": { "type": "array", "description": "1 to 3 image URLs / optimized data URLs" },
        "coverUrl": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "photos", "coverUrl", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/books/{bookId}": {
      "schema": { "$ref": "#/entities/Book" },
      "description": "Public book catalog managed exclusively by administrators"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/CustomCategory" },
      "description": "Custom categories configured by administrators"
    },
    "/home_rows/{rowId}": {
      "schema": { "$ref": "#/entities/HomeRow" },
      "description": "Dynamic home page rows, order, and book assignments managed by administrators"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/PlatformSettings" },
      "description": "Global platform configuration, texts, colors, Hero, and Top 10 settings"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile document isolated per user (readable by owner and admin)"
    },
    "/usernames/{username}": {
      "schema": { "$ref": "#/entities/UsernameReservation" },
      "description": "Unique username reservation index ensuring no two users share the same @username"
    },
    "/public_profiles/{userId}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Public literary profile card for community display and @username mentions"
    },
    "/community_posts/{postId}": {
      "schema": { "$ref": "#/entities/CommunityPost" },
      "description": "Community feed posts (up to 300 characters) with optional image and linked bookId"
    },
    "/community_likes/{likeId}": {
      "schema": { "$ref": "#/entities/CommunityLike" },
      "description": "Individual post likes stored as separate documents"
    },
    "/community_replies/{replyId}": {
      "schema": { "$ref": "#/entities/CommunityReply" },
      "description": "Individual replies to community posts stored as separate documents"
    },
    "/community_follows/{followId}": {
      "schema": { "$ref": "#/entities/CommunityFollow" },
      "description": "Individual user follow relationships stored as separate documents"
    },
    "/community_notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/CommunityNotification" },
      "description": "Per-user community notifications for follows, likes, replies, and mentions"
    },
    "/community_reports/{reportId}": {
      "schema": { "$ref": "#/entities/CommunityReport" },
      "description": "User-submitted moderation reports for posts, reviews, or users"
    },
    "/book_reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/BookReview" },
      "description": "Literary reviews linked to specific catalog books (livro -> reviews -> usuario)"
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/DirectConversation" },
      "description": "Private 1-on-1 conversations accessible exclusively to the two participants"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/DirectMessage" },
      "description": "Private text messages within a conversation accessible exclusively to its two participants"
    },
    "/users/{userId}/library/{bookId}": {
      "schema": { "$ref": "#/entities/UserBookItem" },
      "description": "Strict per-user reading progress, list, favorites, and ratings (readable by owner and admin)"
    },
    "/users/{userId}/highlights/{highlightId}": {
      "schema": { "$ref": "#/entities/ProfileHighlight" },
      "description": "Single active profile highlight per user at /users/{userId}/highlights/profile (up to 3 photos, 1st photo is cover)"
    }
  }
}
